# background opacity 0.0 = fully transparent, 1.0 = opaque

map ctrl+shift+t new_tab

allow_remote_control yes
listen_on unix:/tmp/mykitty

map ctrl+e remote_control set-background-opacity +0.5
map ctrl+shift+e remote_control set-background-opacity 0.0



font_size 22.0

background_opacity 0.5
dynamic_background_opacity yes
# foreground #ffffff
# background #000000
# color0 #666666
# color8 #999999
# color1 #ff5555
# color9 #ff6666
# color3 #f1fa8c
# color11 #ffffa5
# color4 #8be9fd
# color12 #d1f7ff
# color5 #bd93f9
# color13 #d6acff
# color6 #8be9fd
# color14 #a4ffff
# color7 #bbbbbb
# color15 #ffffff
# cursor #ffffff
# selection_foreground #000000
# selection_background #ffffff
# font_family JetBrainsMono Nerd Font
# bold_font   JetBrainsMono Nerd Font Extrabold
# italic_font JetBrainsMono Nerd Font Italic
# bold_italic_font JetBrainsMono Nerd Font Extrabold Italic

disable_ligatures never

font_size 22.0

modify_lines line_height 110%




# BEGIN_KITTY_THEME
# 1984 Orwellian
include current-theme.conf
# END_KITTY_THEME

# BEGIN_KITTY_FONTS
font_family      family="FreeMono"
bold_font        family=FreeMono style=Regular
italic_font      auto
bold_italic_font family=FreeMono style=Regular
# END_KITTY_FONTS